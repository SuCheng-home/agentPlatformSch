# 开发环境（本地联调）
VITE_ENV_TARGET=dev_test
VITE_APP_TITLE=九初智能体平台
VITE_ENV_CONFIG=dev
VITE_BASE_API_URL=https://www.weixiaojia.net
VITE_LOGIN_URL=https://weixiaojia.net/#/login

# 临时本地预览（2026-11-13）：跳过登录初始化与路由校验；恢复登录时设为 false 并重启开发服务。
# 仅开发服务生效，不伪造用户、权限、Token 或业务数据。
VITE_SKIP_LOGIN=true

# 本地模拟数据：使用公开接口快照，业务请求只在浏览器内处理；设为 false 并重启可恢复真实接口。
VITE_USE_MOCK=true
